# Root .dockerignore — applies to the web (workspace) build, whose context is ".".
# Keep only what the web build needs: root package.json, root lockfile, apps/web.

.git
.gitignore
.env
.env.*
!.env.example
.DS_Store
.local-notes
.local-notes/
.superpowers
.superpowers/
.impeccable
.impeccable/
.logs
.logs/
logs
logs/
*.log

# Other apps are irrelevant to the web build and only bloat the context.
apps/api
apps/worker
apps/mastra
packages

# Node / build artifacts (regenerated inside the image).
node_modules
**/node_modules
apps/web/dist
apps/web/.vite

# Python artifacts.
**/__pycache__
**/*.pyc
**/*.pyo
apps/worker/.venv
**/.venv
**/venv

# Misc.
docs
infra
*.md
schema_backup*
*.db
*.sqlite
*.db-shm
*.db-wal
*.pem
*.key
*.p12
*.pfx
*.crt
