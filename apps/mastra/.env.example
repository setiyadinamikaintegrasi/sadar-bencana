# Local Mastra service for Sadar Bencana.
# Hosted production defaults to DeepSeek; local development keeps the
# OpenAI-compatible local provider unless explicitly changed.

MASTRA_AI_PROVIDER=local
OPENAI_API_KEY=local-dev-placeholder
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
MASTRA_MODEL=Gemma-4-E4B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf
# Hosted production:
# MASTRA_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-replace-with-production-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
MASTRA_AI_MAX_OUTPUT_TOKENS=2048
MASTRA_AI_MAX_STEPS=6
SADAR_API_BASE_URL=http://127.0.0.1:8001/api/v1
SADAR_WORKER_BASE_URL=http://127.0.0.1:8002/api/v1/worker
# Use separate random values in production. Generate with: openssl rand -hex 32
WORKER_API_TOKEN=replace-me
MASTRA_API_TOKEN=replace-me-too
API_ENV=local
