    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "@types/supercluster": "^7.1.3",
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.22",
