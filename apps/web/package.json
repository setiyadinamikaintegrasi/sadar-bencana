{
  "name": "@sadar-bencana/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e:map": "playwright test -c playwright.config.ts",
    "test:e2e:map:update-snapshots": "playwright test -c playwright.config.ts --update-snapshots",
    "test:e2e:map:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "hls.js": "^1.7.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "supercluster": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
