# Auth lewat API Go (/auth/login, /auth/register, /auth/me) — tidak ada lagi
# variabel Supabase di frontend.
VITE_API_BASE_URL=/api/v1
VITE_OPERATIONAL_MAP_ENGINE=leaflet

# (Opsional) Cloudflare Turnstile site key — tampilkan widget captcha di LoginGate
# (EWS/Daftar Risiko). Kosongkan untuk dev lokal jika belum setup Turnstile;
# di production diisi bersama TURNSTILE_SECRET_KEY di API.
# Untuk test lokal, pakai always-passes test site key dari Cloudflare:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
