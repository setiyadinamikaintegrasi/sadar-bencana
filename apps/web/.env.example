VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
VITE_API_BASE_URL=/api/v1
VITE_OPERATIONAL_MAP_ENGINE=leaflet

# (Opsional) Cloudflare Turnstile site key — tampilkan widget captcha di LoginGate
# (EWS/Daftar Risiko). Kosongkan untuk dev lokal jika belum setup Turnstile;
# harus diisi di production setelah "Attack Protection > Enable Captcha
# protection" diaktifkan di dashboard Supabase Auth (provider: Turnstile).
# Untuk test lokal, pakai always-passes test site key dari Cloudflare:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
