# Auth memakai supabase-js → GoTrue self-hosted (production:
# https://auth.sadarbencana.id via Caddy yang men-strip /auth/v1).
# Dev: jalankan GoTrue (profile auth infra/local) — Vite mem-proxy /auth/v1.
VITE_SUPABASE_URL=http://localhost:3001
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_API_BASE_URL=/api/v1
VITE_OPERATIONAL_MAP_ENGINE=leaflet

# (Opsional) Cloudflare Turnstile site key — tampilkan widget captcha di LoginGate.
# Untuk test lokal, pakai always-passes test site key dari Cloudflare:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
