# =============================================================================
# Sadar Bencana - example environment
#
# Copy this file to ".env" for docker compose or ".env.local" for local scripts.
# All values below are placeholders. Replace them before running any real use.
# =============================================================================

# --- Supabase / PostgreSQL production database ---
# Use the Supabase pooled connection string, not a local Docker PostgreSQL URL.
# Example host pattern: aws-*-*.pooler.supabase.com
DATABASE_URL=postgresql://postgres.<project-ref>:replace-with-db-password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Supabase Auth ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
# Optional. If unset, the API derives it from SUPABASE_URL.
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# (Opsional) Service role key untuk proxy upload foto lokasi evakuasi ke
# Supabase Storage (bucket evacuation-photos). Kosong = fitur foto nonaktif.
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (used by worker for runtime coordination/cache) ---
# Docker compose default can use redis://redis:6379. Production can use a managed Redis.
REDIS_URL=redis://redis:6379

# --- Worker / LLM ---
# Generate independent values with: openssl rand -hex 32
WORKER_API_TOKEN=replace-me
# Docker Compose service address. For non-Docker local development use
# http://127.0.0.1:8002 instead.
WORKER_BASE_URL=http://worker:8002
LLM_BASE_URL=http://host.docker.internal:8080
LLM_TIMEOUT=180
LLM_MODEL=gemma4-e4b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EWS_DELIVERY_ENABLED=false
# Asset streams are drained every minute. Anonymous OpenSky REST polling is
# slower and backs off exponentially after HTTP 429 responses.
ASSET_POLL_INTERVAL_SECONDS=60
OPENSKY_POLL_INTERVAL_SECONDS=300
OPENSKY_BACKOFF_INITIAL_SECONDS=900
OPENSKY_BACKOFF_MAX_SECONDS=3600

# Official connector flags default to disabled until migrations are applied.
CONNECTOR_BMKG_CAP_ENABLED=false
# Phase 2 shadow mode. Requires migration 022; never auto-merges events.
EVIDENCE_CORRELATION_ENABLED=false
EWS_LIFECYCLE_DELIVERY_ENABLED=false
# Approved official machine-readable feeds. Keep disabled until URL/terms are reviewed.
CONNECTOR_INATEWS_ENABLED=false
INATEWS_FEED_URL=
CONNECTOR_PVMBG_ENABLED=false
PVMBG_FEED_URL=
CONNECTOR_BNPB_ENABLED=false
BNPB_FEED_URL=
CONNECTOR_INARISK_ENABLED=false
INARISK_FEED_URL=
# Sinkron mingguan fasilitas umum (RS/puskesmas/polisi/damkar) dari
# OpenStreetMap Overpass untuk halaman Lokasi Evakuasi. Default nonaktif.
CONNECTOR_EVACUATION_OSM_ENABLED=false
# Long random secret used by PostgreSQL pgcrypto for official API tokens.
OFFICIAL_SOURCE_SETTINGS_KEY=

# --- API ---
API_ENV=docker
MASTRA_BASE_URL=http://host.docker.internal:4111
MASTRA_API_TOKEN=replace-me-too
# Mastra systemd/hosted production. Never commit the real API key.
MASTRA_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
MASTRA_AI_MAX_OUTPUT_TOKENS=2048
MASTRA_AI_MAX_STEPS=6
# community = open-source self-hosted; hosted = sadarbencana.id entitlement mode
DEPLOYMENT_MODE=community
# Applied only when DEPLOYMENT_MODE=hosted. Community mode is unlimited.
PERSONAL_ASSET_LIMIT=20
# Public Ed25519 PEM generated by `go run ./cmd/sadar-license init`.
# Keep the matching private key offline and outside this repository.
ENTITLEMENT_PUBLIC_KEY=
# Address search adapter. Manual map pin remains available if this is unreachable.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=SadarBencana/0.1 (https://sadarbencana.id)
# Optional: send organization invitation codes. Without SMTP, the UI returns a
# copyable code for manual delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sadarbencana.id
EWS_PUBLIC_BASE_URL=https://sadarbencana.id
RISK_FREE_LIMIT=0
AI_BRIEFING_TIMEOUT=150s
# AI features require login. Limits are enforced per authenticated account.
AI_EXECUTIVE_CACHE_TTL=6h
AI_EXECUTIVE_PER_MINUTE=2
AI_EXECUTIVE_PER_DAY=3
AI_EXECUTIVE_GLOBAL_PER_DAY=20
AI_COPILOT_PER_MINUTE=5
AI_COPILOT_PER_DAY=10
AI_COPILOT_GLOBAL_PER_MINUTE=30
AI_COPILOT_GLOBAL_PER_DAY=100
AI_COPILOT_MAX_CHARACTERS=2000
# Comma-separated immediate reverse-proxy IPs/CIDRs. Never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# --- Frontend build/runtime ---
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# (Opsional) Cloudflare Turnstile site key untuk widget captcha di LoginGate.
# Wajib diisi di production setelah "Attack Protection > Enable Captcha
# protection" (provider Turnstile) diaktifkan di dashboard Supabase Auth.
# VITE_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# --- CORS (production only) ---
# Comma-separated list of allowed origins.
# Example: CORS_ALLOWED_ORIGINS=https://sadarbencana.id,https://www.sadarbencana.id
CORS_ALLOWED_ORIGINS=
